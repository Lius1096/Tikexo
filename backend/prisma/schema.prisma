generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String     @id @default(cuid())
  telephone             String     @unique
  nom                   String
  prenom                String
  email_perso           String?    @unique
  email_pro             String?    @unique
  invitation_token      String?    @unique
  pin_hash              String?
  mot_de_passe_hash     String?
  biometrie_activee     Boolean    @default(false)
  role                  Role
  statut                StatutUser @default(INACTIF)

  kyc_niveau            NiveauKYC  @default(ZERO)
  kyc_via_entreprise    Boolean    @default(false)

  fcm_token             String?
  langue                String     @default("fr")
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  wallet                Wallet?
  otpCodes              OtpCode[]
  notifications         Notification[]
  auditLogs             AuditLog[]
  cartesVirtuelles      CarteDigi[]
  liensBeneficiaire     LienEntrepriseBeneficiaire[] @relation("UserLiens")
  entrepriseAdmin       EntrepriseAdmin?
  commercant            Commercant?
  transactions          Transaction[]
  mutations             Mutation[]
  ticketsSupport        TicketSupport[]
  messagesSupport       TicketSupportMessage[]
  broadcastsEnvoyes     Broadcast[]
  emailTemplatesModifies EmailTemplate[]
  cguVersionsPubliees    CGUVersion[]

  @@index([telephone])
  @@index([email_perso])
  @@index([role, statut])
}

model Entreprise {
  id                      String           @id @default(cuid())
  nom                     String
  rccm                    String?
  ifu                     String           @unique
  secteur                 String?
  adresse                 String?
  ville                   String           @default("Cotonou")
  telephone_rh            String?
  email_rh                String?
  statut                  StatutEntreprise @default(EN_ATTENTE)
  plan                    String           @default("PME_S")
  nb_employes             String?
  frais_mensuel           Decimal?         @db.Decimal(10,2)
  dotation_max            Decimal?         @db.Decimal(10,2)
  montant_max_wallet      Decimal?         @db.Decimal(12,2)
  // Plafond de FLUX cumulé (somme des recharges FedaPay réussies) sur le mois
  // calendaire en cours — distinct de montant_max_wallet qui ne borne que le
  // solde instantané et se contourne en dépensant puis rechargeant en boucle.
  plafond_recharge_mensuel Decimal?        @db.Decimal(12,2)
  kyb_valide              Boolean          @default(false)
  taux_commission_defaut  Decimal          @db.Decimal(5,2) @default(5.00)
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  wallet                  Wallet?
  liensBeneficiaires      LienEntrepriseBeneficiaire[]
  admins                  EntrepriseAdmin[]
  dotations               Dotation[]
  mutationsSortie         Mutation[]  @relation("MutationEntrepriseA")
  mutationsEntree         Mutation[]  @relation("MutationEntrepriseB")
  fedapayOperations       FedapayOperation[]
  kyb_dossier             KybDossier?
  demandesPlafond         DemandePlafond[]

  @@index([statut])
  @@index([kyb_valide])
}

model KybDossier {
  id                       String        @id @default(cuid())
  entreprise_id            String        @unique
  statut                   StatutKyb     @default(NON_SOUMIS)
  soumis_at                DateTime?
  valide_at                DateTime?
  valide_par               String?
  rejete_at                DateTime?
  rejete_par               String?
  kyb_deadline             DateTime
  kyb_deadline_extended_at DateTime?
  note_admin               String?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  entreprise               Entreprise    @relation(fields: [entreprise_id], references: [id])
  documents                KybDocument[]

  @@index([statut])
  @@index([kyb_deadline])
}

model KybDocument {
  id              String            @id @default(cuid())
  dossier_id      String
  type            TypeKybDocument
  statut          StatutKybDocument @default(EN_ATTENTE)
  fichier_url     String
  fichier_nom     String
  fichier_taille  Int
  fichier_format  String
  cloudinary_id   String?
  motif_rejet     String?
  rejete_par      String?
  rejete_at       DateTime?
  valide_par      String?
  valide_at       DateTime?
  version         Int               @default(1)
  remplace_id     String?
  createdAt       DateTime          @default(now())

  dossier         KybDossier        @relation(fields: [dossier_id], references: [id])

  @@index([dossier_id, type])
  @@index([statut])
}

model LienEntrepriseBeneficiaire {
  id                   String        @id @default(cuid())
  entreprise_id        String
  user_id              String
  niveau               NiveauSalarie
  poste                String?
  allocation_mensuelle Decimal       @db.Decimal(10,2) @default(5000)
  date_debut           DateTime      @default(now())
  date_fin             DateTime?
  statut               StatutLien    @default(ACTIF)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  entreprise          Entreprise    @relation(fields: [entreprise_id], references: [id])
  user                User          @relation("UserLiens", fields: [user_id], references: [id])
  dotations           Dotation[]

  @@unique([entreprise_id, user_id, statut])
  @@index([entreprise_id, statut])
  @@index([user_id, statut])
}

model EntrepriseAdmin {
  id            String    @id @default(cuid())
  entreprise_id String
  user_id       String    @unique
  role          Role      @default(ADMIN_RH)
  matricule     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  entreprise    Entreprise @relation(fields: [entreprise_id], references: [id])
  user          User       @relation(fields: [user_id], references: [id])

  @@unique([entreprise_id, matricule])
  @@index([entreprise_id])
}

model Wallet {
  id             String       @id @default(cuid())
  user_id        String?      @unique
  entreprise_id  String?      @unique
  type           TypeWallet
  solde          Decimal      @db.Decimal(12,2) @default(0)
  solde_reserve  Decimal      @db.Decimal(12,2) @default(0)
  currency       String       @default("XOF")
  statut         StatutWallet @default(ACTIF)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user           User?        @relation(fields: [user_id], references: [id])
  entreprise     Entreprise?  @relation(fields: [entreprise_id], references: [id])
  ledgerEntrees  LedgerEntry[] @relation("WalletSource")
  ledgerSorties  LedgerEntry[] @relation("WalletDestination")

  @@index([type, statut])
}

// CŒUR DU SYSTÈME — IMMUABLE — JAMAIS DE UPDATE NI DELETE
model LedgerEntry {
  id                    String     @id @default(cuid())
  wallet_source_id      String?
  wallet_destination_id String?
  montant               Decimal    @db.Decimal(12,2)
  type                  TypeLedger
  reference_fedapay     String?
  transaction_id        String?
  source_entreprise_id  String?
  metadata              Json?
  createdAt             DateTime   @default(now())

  walletSource          Wallet?    @relation("WalletSource", fields: [wallet_source_id], references: [id])
  walletDestination     Wallet?    @relation("WalletDestination", fields: [wallet_destination_id], references: [id])
  transaction           Transaction? @relation(fields: [transaction_id], references: [id])

  @@index([wallet_source_id, createdAt])
  @@index([wallet_destination_id, createdAt])
  @@index([type, createdAt])
  @@index([reference_fedapay])
}

model Transaction {
  id                    String            @id @default(cuid())
  beneficiaire_id       String
  commercant_id         String
  montant_total         Decimal           @db.Decimal(10,2)
  montant_tikexo        Decimal           @db.Decimal(10,2)
  montant_complement    Decimal           @db.Decimal(10,2) @default(0)
  commission_tikexo     Decimal           @db.Decimal(10,2)
  statut                StatutTransaction @default(EN_COURS)
  fedapay_complement_id String?
  source_entreprise_id  String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  beneficiaire          User              @relation(fields: [beneficiaire_id], references: [id])
  commercant            Commercant        @relation(fields: [commercant_id], references: [id])
  ledgerEntries         LedgerEntry[]

  @@index([beneficiaire_id, createdAt])
  @@index([commercant_id, createdAt])
  @@index([statut])
}

model Commercant {
  id                      String           @id @default(cuid())
  user_id                 String           @unique
  nom                     String
  type                    TypeCommercant
  ifu                     String?
  niveau                  NiveauCommercant @default(SIMPLIFIE)
  mobile_money_numero     String
  mobile_money_operateur  OperateurMobile
  latitude                Decimal?         @db.Decimal(10,8)
  longitude               Decimal?         @db.Decimal(11,8)
  adresse                 String?
  ville                   String           @default("Cotonou")
  horaires                Json?
  statut                  StatutCommercant @default(SOUMIS)
  photo_url               String?
  qr_code_url             String?
  taux_commission         Decimal          @db.Decimal(5,2) @default(5.00)
  mode_reversement        ModeReversement  @default(AUTO_72H)
  plafond_mensuel         Decimal          @db.Decimal(12,2) @default(500000)
  volume_mensuel_cumule   Decimal          @db.Decimal(12,2) @default(0)
  note_moyenne            Decimal          @db.Decimal(3,2)  @default(0)
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  user                    User             @relation(fields: [user_id], references: [id])
  transactions            Transaction[]
  fedapayPayouts          FedapayOperation[]
  documents               CommercantDocument[]
  ticketsRetrait          TicketRetrait[]

  @@index([statut])
  @@index([ville, statut])
  @@index([latitude, longitude])
}

// KYC commerçant volontairement léger (pas de "dossier"/deadline comme le KYB
// entreprise) : au Bénin, la plupart des commerçants (restaurants, etc.) n'ont
// pas d'entreprise formelle — la pièce d'identité du gérant suffit pour le
// niveau SIMPLIFIE. Le justificatif IFU n'est pertinent que pour VERIFIE.
// Les documents n'empêchent jamais la validation/activation par l'admin.
model CommercantDocument {
  id             String                 @id @default(cuid())
  commercant_id  String
  type           TypeCommercantDocument
  statut         StatutKybDocument      @default(EN_ATTENTE)
  fichier_url    String
  fichier_nom    String
  fichier_taille Int
  motif_rejet    String?
  rejete_par     String?
  rejete_at      DateTime?
  valide_par     String?
  valide_at      DateTime?
  createdAt      DateTime               @default(now())

  commercant     Commercant             @relation(fields: [commercant_id], references: [id])

  @@index([commercant_id])
  @@index([statut])
}

// Demande de retrait manuelle — en attendant l'intégration FedaPay "checkout
// envoi multiple", tout reversement anticipé passe par un ticket que le
// commerçant ouvre lui-même (dès SEUIL_TICKET_RETRAIT atteint côté service),
// traité manuellement par un admin TIKEXO qui joint une preuve de paiement
// (capture Mobile Money) ; la validation débite alors directement le wallet
// commerçant. Remplace l'ancien déclenchement direct de FedaPay.Payout par
// le commerçant (cf. fedapay.service.js#declencherPayout, conservé mais plus
// appelé depuis ce flux).
model TicketRetrait {
  id            String              @id @default(cuid())
  commercant_id String
  montant       Decimal             @db.Decimal(12,2)
  statut        StatutTicketRetrait @default(EN_ATTENTE)
  preuve_url    String?
  motif_rejet   String?
  traite_par    String?
  createdAt     DateTime            @default(now())
  traite_at     DateTime?

  commercant    Commercant          @relation(fields: [commercant_id], references: [id])

  @@index([commercant_id, statut])
  @@index([statut])
}

model FedapayOperation {
  id                     String        @id @default(cuid())
  type                   TypeFedapay
  fedapay_transaction_id String        @unique
  montant                Decimal       @db.Decimal(12,2)
  statut                 StatutFedapay @default(EN_ATTENTE)
  wallet_id              String?
  entreprise_id          String?
  commercant_id          String?
  tentatives             Int           @default(0)
  prochaine_tentative    DateTime?
  webhook_payload        Json?
  erreur_message         String?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  entreprise             Entreprise?   @relation(fields: [entreprise_id], references: [id])
  commercant             Commercant?   @relation(fields: [commercant_id], references: [id])

  @@index([statut, prochaine_tentative])
  @@index([type, statut])
}

model Dotation {
  id               String         @id @default(cuid())
  entreprise_id    String
  beneficiaire_id  String
  lien_id          String
  montant_total    Decimal        @db.Decimal(10,2)
  mois_concerne    DateTime
  statut           StatutDotation @default(CALCULE)
  valide_par       String?
  valide_at        DateTime?
  distribue_at     DateTime?
  createdAt        DateTime       @default(now())

  entreprise       Entreprise     @relation(fields: [entreprise_id], references: [id])
  lien             LienEntrepriseBeneficiaire @relation(fields: [lien_id], references: [id])

  @@unique([lien_id, mois_concerne])
  @@index([entreprise_id, mois_concerne])
  @@index([statut])
}

// Demande employeur de relever un plafond (solde wallet ou flux mensuel) —
// jamais modifiable directement par l'entreprise elle-même (voir
// entreprise.service.js#modifier, qui bloque ces champs pour les rôles
// employeur) : seul un admin TIKEXO peut approuver et appliquer le nouveau
// montant.
model DemandePlafond {
  id               String               @id @default(cuid())
  entreprise_id    String
  type             TypePlafond
  montant_actuel   Decimal?             @db.Decimal(12,2)
  montant_demande  Decimal              @db.Decimal(12,2)
  justification    String?
  statut           StatutDemandePlafond @default(EN_ATTENTE)
  demande_par      String
  traite_par       String?
  note_admin       String?
  createdAt        DateTime             @default(now())
  traite_at        DateTime?

  entreprise       Entreprise           @relation(fields: [entreprise_id], references: [id])

  @@index([entreprise_id, statut])
  @@index([statut])
}

model Mutation {
  id                       String         @id @default(cuid())
  user_id                  String
  entreprise_a_id          String
  entreprise_b_id          String?
  lien_a_id                String
  lien_b_id                String?
  option_solde             OptionSolde?
  montant_rembourse        Decimal?       @db.Decimal(10,2)
  fedapay_remboursement_id String?
  email_pro_avant          String?
  email_pro_apres          String?
  date_depart_a            DateTime?
  archive_planifie_at      DateTime
  traite_par               String?
  traite_at                DateTime?
  statut                   StatutMutation @default(EN_ATTENTE)
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt

  user                     User           @relation(fields: [user_id], references: [id])
  entrepriseA              Entreprise     @relation("MutationEntrepriseA", fields: [entreprise_a_id], references: [id])
  entrepriseB              Entreprise?    @relation("MutationEntrepriseB", fields: [entreprise_b_id], references: [id])

  @@index([user_id])
  @@index([statut])
  @@index([archive_planifie_at])
}

model CarteDigi {
  id                       String      @id @default(cuid())
  user_id                  String
  type                     TypeCarte
  // Sécurité numéro
  numero_hash              String      @unique  // SHA-256 — jamais le numéro en clair
  numero_masque            String               // "4782 •••• •••• 3291"
  prefixe                  String      @default("4782")
  suffixe                  String               // 4 derniers chiffres
  luhn_valide              Boolean     @default(true)
  date_expiration          DateTime
  statut                   StatutCarte @default(ACTIVE)
  // NFC
  nfc_active               Boolean     @default(false)
  nfc_derniere_utilisation DateTime?
  // QR Code
  qr_code_url              String?
  qr_expires_at            DateTime?
  qr_refresh_count         Int         @default(0)
  // Carte physique
  adresse_livraison        String?
  code_activation_hash     String?
  activee_at               DateTime?
  expedie_at               DateTime?
  livree_at                DateTime?

  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt

  user                     User        @relation(fields: [user_id], references: [id])

  @@index([user_id, statut])
  @@index([numero_hash])
}

model QRCodeTransaction {
  id         String    @id @default(cuid())
  wallet_id  String
  nonce      String    @unique
  montant    Decimal?  @db.Decimal(10, 2)
  utilise    Boolean   @default(false)
  utilise_at DateTime?
  expires_at DateTime
  createdAt  DateTime  @default(now())

  @@index([nonce])
  @@index([wallet_id, utilise])
}

model NFCToken {
  id             String    @id @default(cuid())
  wallet_id      String
  token_unique   String    @unique
  utilise        Boolean   @default(false)
  expires_at     DateTime
  transaction_id String?
  createdAt      DateTime  @default(now())

  @@index([token_unique])
}

// IMMUABLE — JAMAIS DE UPDATE NI DELETE
model AuditLog {
  id         String   @id @default(cuid())
  user_id    String?
  action     String
  entite     String
  entite_id  String?
  avant      Json?
  apres      Json?
  ip         String?
  user_agent String?
  createdAt  DateTime @default(now())

  user       User?    @relation(fields: [user_id], references: [id])

  @@index([user_id, createdAt])
  @@index([entite, entite_id])
  @@index([createdAt])
}

model OtpCode {
  id         String   @id @default(cuid())
  telephone  String
  code_hash  String
  expiration DateTime
  utilise    Boolean  @default(false)
  tentatives Int      @default(0)
  createdAt  DateTime @default(now())

  user       User?    @relation(fields: [telephone], references: [telephone])

  @@index([telephone, utilise, expiration])
}

model Notification {
  id        String           @id @default(cuid())
  user_id   String
  titre     String
  corps     String
  type      TypeNotification
  lu        Boolean          @default(false)
  fcm_token String?
  createdAt DateTime         @default(now())

  user      User             @relation(fields: [user_id], references: [id])

  @@index([user_id, lu])
}

// Historique des communications de masse envoyées depuis /admin/broadcast
// (une ou plusieurs entreprises, tous les bénéficiaires, ou tous les
// commerçants) — répond au même besoin que les annonces produit envoyées
// par les plateformes concurrentes (Pluxy...) lors d'un changement réel.
model Broadcast {
  id               String         @id @default(cuid())
  envoye_par       String
  cible            CibleBroadcast
  entreprise_ids   String[]
  titre            String
  corps            String
  type             TypeNotification
  canaux           String[]
  piece_jointe_url String?
  nb_destinataires Int
  createdAt        DateTime       @default(now())

  admin            User           @relation(fields: [envoye_par], references: [id])

  @@index([createdAt])
}

