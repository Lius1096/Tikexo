model LandingConfig {
  id         String   @id @default(cuid())
  section    String   @unique
  data       Json
  updated_at DateTime @updatedAt

  @@map("landing_config")
}

// Personnalisation admin d'un email transactionnel, sans déploiement. `cle`
// identifie le point d'envoi dans le code (ex: "BIENVENUE_ENTREPRISE"). Tant
// qu'aucune ligne n'existe pour une clé donnée, le code utilise son modèle
// par défaut codé en dur (voir utils/emailTemplateOverride.js) — aucune
// perte de contenu, aucun risque de casser un email si l'admin n'a rien
// personnalisé. `corps` est du texte brut avec {{variables}} — jamais de
// HTML : l'admin n'a pas à connaître de balises, la mise en forme (gabarit
// de marque TIKEXO, paragraphes) est appliquée automatiquement à l'envoi.
model EmailTemplate {
  cle          String   @id
  sujet        String
  corps        String
  variables    String[]
  modifie_par  String
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  admin        User     @relation(fields: [modifie_par], references: [id])
}

// Historique des versions des CGU publiées depuis /admin/cgu. La page
// publique /cgu affiche toujours la dernière version ; tant qu'aucune n'a
// été publiée, elle affiche le texte codé en dur existant (aucune perte du
// contenu légal actuel, aucune migration de données risquée).
model CGUVersion {
  id          String   @id @default(cuid())
  version     Int
  contenu     String
  publie_par  String
  createdAt   DateTime @default(now())

  admin       User     @relation(fields: [publie_par], references: [id])

  @@index([createdAt])
}

// Support client structuré, ouvert par un employeur, un bénéficiaire ou un
// commerçant. Remplace la simple adresse email support@tikexo.kete.fr citée
// un peu partout dans le code (messages d'erreur, emails) sans qu'aucun
// système ne trace réellement ces demandes.
model TicketSupport {
  id         String              @id @default(cuid())
  user_id    String
  categorie  CategorieSupport    @default(AUTRE)
  sujet      String
  statut     StatutTicketSupport @default(OUVERT)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  user       User                    @relation(fields: [user_id], references: [id])
  messages   TicketSupportMessage[]

  @@index([user_id, statut])
  @@index([statut])
}

model TicketSupportMessage {
  id          String   @id @default(cuid())
  ticket_id   String
  auteur_id   String
  // Snapshot du rôle au moment de l'envoi (le rôle de l'auteur en base peut
  // changer plus tard) — sert à afficher "Vous" / "TIKEXO" dans le fil sans
  // recharger l'auteur à chaque fois pour connaître son rôle.
  auteur_role Role
  message     String
  piece_jointe_url String?
  createdAt   DateTime @default(now())

  ticket      TicketSupport @relation(fields: [ticket_id], references: [id])
  auteur      User          @relation(fields: [auteur_id], references: [id])

  @@index([ticket_id, createdAt])
}

// Réglages globaux de la plateforme, modifiables depuis /admin/configuration.
// Ligne singleton (id fixe "singleton"), stockée en base pour survivre aux
// redéploiements, contrairement à l'ancien fichier platform-config.json qui
// vivait dans le système de fichiers éphémère du conteneur et était donc
// remis à zéro à chaque déploiement, sans jamais réellement piloter le
// comportement de l'application (voir utils/platformConfig.js).
model PlatformConfig {
  id                            String   @id @default("singleton")
  taux_frais_benef_defaut       Decimal  @db.Decimal(5,2)  @default(5.00)
  taux_frais_commercant_defaut  Decimal  @db.Decimal(5,2)  @default(5.00)
  plafond_journalier            Decimal  @db.Decimal(12,2) @default(10000)
  seuil_ticket_retrait          Decimal  @db.Decimal(12,2) @default(50000)
  updatedAt                     DateTime @updatedAt
}
