# ═══════════════════════════════════════════════════════════════════════════
# TIKEXO — Variables d'environnement PRODUCTION (VPS Ionos, docker-compose.prod.yml)
#
# ⚠️  ATTENTION — piège classique de Docker Compose :
#     `docker compose` N'INTERPOLE PAS les `${VAR}` à l'intérieur des valeurs
#     d'un `env_file`. L'interpolation `${VAR}` ne fonctionne QUE dans le
#     fichier docker-compose.yml lui-même (section `environment:`), jamais
#     dans le contenu d'un fichier passé via `env_file:`.
#     => Ici, DATABASE_URL et REDIS_URL doivent contenir le mot de passe
#        RECOPIÉ EN DUR dans la chaîne de connexion, pas une référence
#        `${POSTGRES_PASSWORD}` (qui serait passée telle quelle, littéralement,
#        à l'application — bug silencieux garanti).
#     => scripts/generate-secrets.sh gère ça pour vous : il remplace le même
#        placeholder CHANGE_ME_* partout où il apparaît dans ce fichier, donc
#        le mot de passe reste synchronisé entre POSTGRES_PASSWORD et
#        DATABASE_URL automatiquement.
# ═══════════════════════════════════════════════════════════════════════════

# ─── Postgres ───────────────────────────────────────────────────────────────
POSTGRES_USER=tikexo
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
# Mot de passe recopié en dur ci-dessous (voir avertissement plus haut) :
DATABASE_URL=postgresql://tikexo:CHANGE_ME_POSTGRES_PASSWORD@postgres:5432/tikexo_prod

# ─── Redis (BullMQ / queues) ────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_JWT_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_JWT_REFRESH_SECRET
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Serveur ──────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production
FRONTEND_URL=https://tikexo.kete.fr

# ─── Paiements FedaPay ────────────────────────────────────────────────────────
FEDAPAY_SECRET_KEY=
FEDAPAY_PUBLIC_KEY=
FEDAPAY_ENV=sandbox
FEDAPAY_WEBHOOK_SECRET=

# ─── Stockage objet — MinIO (interne au VPS, servi via /media sur l'app) ────
MINIO_ROOT_USER=tikexo
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_ROOT_PASSWORD
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=tikexo
# Même valeur que MINIO_ROOT_PASSWORD ci-dessus (recopiée en dur, voir avertissement) :
S3_SECRET_KEY=CHANGE_ME_MINIO_ROOT_PASSWORD
S3_BUCKET=tikexo-documents
S3_REGION=auto
S3_PUBLIC_URL=

# ─── Stockage Cloudinary (optionnel, si encore utilisé) ──────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Firebase (push mobile) ───────────────────────────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# ─── Règles métier TIKEXO ─────────────────────────────────────────────────────
TIKEXO_COMMISSION_DEFAULT=2.00
TIKEXO_COMMISSION_MENSUEL=1.50
TIKEXO_PAYOUT_SEUIL_MINIMUM=1000
TIKEXO_PAYOUT_CYCLE_HEURES=72
TIKEXO_PLAFOND_JOURNALIER_DEFAULT=10000
TIKEXO_PLAFOND_SIMPLIFIE_MENSUEL=500000

# ─── Email SMTP — Ionos (boîtes créées sur le sous-domaine tikexo.kete.fr) ────
# Host exact à vérifier dans le panel Ionos (Mail → Paramètres serveur) —
# smtp.ionos.fr pour un compte Ionos France, sinon smtp.ionos.de / .com selon
# le contrat. Port 587 (STARTTLS) recommandé.
# SMTP_PASS = mot de passe de la boîte noreply@tikexo.kete.fr créée dans Ionos
# (pas un secret généré par generate-secrets.sh — à saisir à la main).
SMTP_HOST=smtp.ionos.fr
SMTP_PORT=587
SMTP_USER=noreply@tikexo.kete.fr
SMTP_PASS=
# Boîte surveillée pour les réponses (Reply-To) — également créée dans Ionos :
MAIL_RECEIVER=support@tikexo.kete.fr

# ─── Carte TIKEXO ─────────────────────────────────────────────────────────────
CARTE_PREFIXE=4782
CARTE_QR_SECRET_KEY=CHANGE_ME_CARTE_QR_SECRET_KEY
CARTE_NFC_SECRET_KEY=CHANGE_ME_CARTE_NFC_SECRET_KEY
CARTE_CVV_SECRET_KEY=CHANGE_ME_CARTE_CVV_SECRET_KEY
CARTE_NFC_MONTANT_MAX=5000

# ─── SMS Africa's Talking ─────────────────────────────────────────────────────
SMS_API_KEY=
SMS_USERNAME=sandbox

# ─── Monitoring Sentry (optionnel) ────────────────────────────────────────────
SENTRY_DSN=
