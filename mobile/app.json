{
  "expo": {
    "name": "Tikexo",
    "slug": "tikexo",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "tikexo",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A3C5E"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "bj.tikexo.app",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1A3C5E"
      },
      "package": "bj.tikexo.app",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "TIKEXO utilise la caméra pour scanner les QR codes de paiement"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1A3C5E"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "TIKEXO utilise Face ID pour sécuriser votre compte"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "TIKEXO utilise votre position pour trouver les commerçants partenaires proches de vous"
        }
      ],
      "expo-asset",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "85355b85-a449-4bef-9244-04b44294952c"
      }
    },
    "owner": "lius96"
  }
}
